@page "/"
@using GhcSamplePs.Core.Services.Interfaces
@using GhcSamplePs.Core.Models.PlayerManagement.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "RequireUserRole")]
@inject IPlayerService PlayerService
@inject ITeamPlayerService TeamPlayerService
@inject IPlayerStatisticService PlayerStatisticService
@inject ICurrentUserProvider CurrentUserProvider

<PageTitle>Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    @* AuthorizeView for authenticated vs anonymous users *@
    <AuthorizeView>
        <Authorized>
            <MudPaper Elevation="2" Class="pa-4 mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Success" />
                    <MudText Typo="Typo.h6">Welcome, @context.User.Identity?.Name! - @string.Join(", ", context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</MudText>
                </MudStack>
                <MudText Typo="Typo.body1">You are signed in and can access authenticated content.</MudText>
            </MudPaper>
        </Authorized>
        <NotAuthorized>
            <MudPaper Elevation="2" Class="pa-4 mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Color="Color.Default" />
                    <MudText Typo="Typo.h6">Welcome, Guest!</MudText>
                </MudStack>
                <MudText Typo="Typo.body1">Please sign in to access personalized content.</MudText>
            </MudPaper>
        </NotAuthorized>
    </AuthorizeView>

    @* AuthorizeView with Role-based content for Admin users *@
    <AuthorizeView Policy="RequireAdminRole">
        <Authorized>
            <MudAlert Severity="Severity.Info" Class="mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                    <MudText Typo="Typo.body1">
                        <strong>Admin Access:</strong> You have administrative privileges. 
                        Visit the <MudLink Href="/admin">Admin Dashboard</MudLink> to manage the application.
                    </MudText>
                </MudStack>
            </MudAlert>
        </Authorized>
    </AuthorizeView>

    @* AuthorizeView with Role-based content for regular users (User or Admin role) *@
    <AuthorizeView Policy="RequireUserRole">
        <Authorized>
            <MudPaper Elevation="2" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Your Dashboard</MudText>
                </MudStack>

                @* Loading state *@
                @if (_isLoading)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="my-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Loading dashboard...</MudText>
                    </MudStack>
                }
                @* Error state *@
                else if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">
                        @_errorMessage
                    </MudAlert>
                }
                @* Dashboard summary cards *@
                else
                {
                    @* Empty state for users with no players *@
                    @if (_totalPlayers == 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">
                            <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="my-4">
                                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Color="Color.Info" />
                                <MudText Typo="Typo.h6">No players yet</MudText>
                                <MudText Typo="Typo.body2" Align="Align.Center">
                                    Add your first player to get started and begin tracking statistics.
                                </MudText>
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Primary" 
                                           Href="/players/create"
                                           StartIcon="@Icons.Material.Filled.PersonAdd">
                                    Add Your First Player
                                </MudButton>
                            </MudStack>
                        </MudAlert>
                    }
                    else
                    {
                    <MudGrid Spacing="3">
                        @* Total Players Card *@
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="1" Class="pa-4 text-center">
                                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Medium" />
                                <MudText Typo="Typo.h4" Color="Color.Primary" Class="mt-2">@_totalPlayers</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Players</MudText>
                            </MudPaper>
                        </MudItem>

                        @* Active Teams Card *@
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="1" Class="pa-4 text-center">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Warning" Size="Size.Medium" />
                                <MudText Typo="Typo.h4" Color="Color.Warning" Class="mt-2">@_activeTeams</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Active Teams</MudText>
                            </MudPaper>
                        </MudItem>

                        @* Total Games Card *@
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="1" Class="pa-4 text-center">
                                <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Color="Color.Info" Size="Size.Medium" />
                                <MudText Typo="Typo.h4" Color="Color.Info" Class="mt-2">@_totalGames</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Games Played</MudText>
                            </MudPaper>
                        </MudItem>

                        @* Total Goals Card *@
                        <MudItem xs="12" sm="6" md="3">
                            <MudPaper Elevation="1" Class="pa-4 text-center">
                                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Success" Size="Size.Medium" />
                                <MudText Typo="Typo.h4" Color="Color.Success" Class="mt-2">@_totalGoals</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Total Goals</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    @* Recent Activity and Active Teams - Side by Side Panels *@
                    <MudGrid Class="mt-4" Spacing="3">
                        @* Left Panel - Recent Activity *@
                        <MudItem xs="12" md="6">
                            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" />
                                    <MudText Typo="Typo.h6">Recent Activity</MudText>
                                </MudStack>

                                @if (_recentActivities is not null && _recentActivities.Count > 0)
                                {
                                    <MudTable Items="@_recentActivities" Hover="true" Dense="true" Striped="true">
                                        <HeaderContent>
                                            <MudTh>Player / Team</MudTh>
                                            <MudTh>Date</MudTh>
                                            <MudTh>Stats</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="activity">
                                            <MudTd DataLabel="Player / Team">
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.body2"><strong>@activity.PlayerName</strong></MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@activity.TeamName</MudText>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Date">
                                                <MudText Typo="Typo.body2">@activity.GameDate.ToString("MM/dd/yyyy")</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="Stats">
                                                <MudStack Row="true" Spacing="1">
                                                    @if (activity.Goals > 0)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@activity.Goals G</MudChip>
                                                    }
                                                    @if (activity.Assists > 0)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@activity.Assists A</MudChip>
                                                    }
                                                    @if (activity.Goals == 0 && activity.Assists == 0)
                                                    {
                                                        <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                                    }
                                                </MudStack>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                                else
                                {
                                    <MudStack AlignItems="AlignItems.Center" Class="my-8">
                                        <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Size="Size.Large" Color="Color.Secondary" />
                                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No recent games</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            Record game statistics to see recent activity.
                                        </MudText>
                                    </MudStack>
                                }
                            </MudPaper>
                        </MudItem>

                        @* Right Panel - Active Teams Overview *@
                        <MudItem xs="12" md="6">
                            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Warning" />
                                    <MudText Typo="Typo.h6">Active Teams</MudText>
                                </MudStack>

                                @if (_activeTeamsList is not null && _activeTeamsList.Count > 0)
                                {
                                    <MudList T="string" Dense="true">
                                        @for (int i = 0; i < _activeTeamsList.Count; i++)
                                        {
                                            var team = _activeTeamsList[i];
                                            <MudListItem>
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.body2"><strong>@team.TeamName</strong></MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@team.ChampionshipName</MudText>
                                                </MudStack>
                                            </MudListItem>
                                            @if (i < _activeTeamsList.Count - 1)
                                            {
                                                <MudDivider />
                                            }
                                        }
                                    </MudList>
                                }
                                else
                                {
                                    <MudStack AlignItems="AlignItems.Center" Class="my-8">
                                        <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Color="Color.Secondary" />
                                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">No active teams</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            Join a team to see your active team assignments.
                                        </MudText>
                                    </MudStack>
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    @* Quick Actions Section *@
                    <MudPaper Elevation="2" Class="pa-4 mt-4">
                        <MudText Typo="Typo.h6" Class="mb-3">Quick Actions</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Href="/players"
                                       StartIcon="@Icons.Material.Filled.People">
                                View All Players
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary" 
                                       Href="/players/create"
                                       StartIcon="@Icons.Material.Filled.PersonAdd">
                                Add New Player
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    @* Top Performers Section *@
                    @if (_topPerformers is not null && _topPerformers.Count > 0)
                    {
                        <MudPaper Elevation="2" Class="pa-4 mt-4">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Stars" Color="Color.Warning" />
                                <MudText Typo="Typo.h6">Top Performers</MudText>
                            </MudStack>
                            <MudSimpleTable Hover="true" Dense="true" Striped="true">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Player</th>
                                        <th>Total Goals</th>
                                        <th>Games Played</th>
                                        <th>Goals/Game</th>
                                        <th>Total Assists</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < _topPerformers.Count; i++)
                                    {
                                        var rank = i + 1;
                                        var performer = _topPerformers[i];
                                        <tr>
                                            <td>
                                                <MudChip T="string" Size="Size.Small" Color="@GetRankColor(rank)">
                                                    #@rank
                                                </MudChip>
                                            </td>
                                            <td>@performer.PlayerName</td>
                                            <td>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success">@performer.TotalGoals</MudChip>
                                            </td>
                                            <td>@performer.GamesPlayed</td>
                                            <td>@performer.GoalsPerGame.ToString("F2")</td>
                                            <td>@performer.TotalAssists</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                    }
                    }
                }
            </MudPaper>
        </Authorized>
    </AuthorizeView>
</MudContainer>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private int _totalPlayers;
    private int _activeTeams;
    private int _totalGames;
    private int _totalGoals;
    private IReadOnlyList<RecentActivityDto>? _recentActivities;
    private IReadOnlyList<TopPerformerDto>? _topPerformers;
    private List<(string TeamName, string ChampionshipName)>? _activeTeamsList;

    private string CurrentUserId => CurrentUserProvider.GetCurrentUser()?.Identity?.Name ?? "system";

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            // Load all independent data in parallel for better performance
            var playersTask = PlayerService.GetAllPlayersAsync();
            var recentActivityTask = PlayerStatisticService.GetRecentActivityAsync(CurrentUserId, 10);
            var topPerformersTask = PlayerStatisticService.GetTopPerformersAsync(CurrentUserId, 5);

            await Task.WhenAll(playersTask, recentActivityTask, topPerformersTask);

            var playersResult = await playersTask;
            if (!playersResult.Success || playersResult.Data is null)
            {
                _errorMessage = "Unable to load dashboard data. Please try again.";
                return;
            }

            var players = playersResult.Data
                .Where(p => string.Equals(p.UserId, CurrentUserId, StringComparison.OrdinalIgnoreCase))
                .ToList();

            _totalPlayers = players.Count;

            // Handle empty state - new user with no players
            if (_totalPlayers == 0)
            {
                _activeTeams = 0;
                _totalGames = 0;
                _totalGoals = 0;
                _recentActivities = null;
                _topPerformers = null;
                _activeTeamsList = null;
                return;
            }

            // Load team and statistics data in parallel for all players
            var teamTasks = players.Select(p => TeamPlayerService.GetActiveTeamsByPlayerIdAsync(p.Id)).ToList();
            var statsTasks = players.Select(p => PlayerStatisticService.GetStatisticsByPlayerIdAsync(p.Id)).ToList();

            var allTasks = new List<Task>();
            allTasks.AddRange(teamTasks.Cast<Task>());
            allTasks.AddRange(statsTasks.Cast<Task>());
            await Task.WhenAll(allTasks);

            var activeTeamsSet = new HashSet<(string TeamName, string ChampionshipName)>();
            var allGames = 0;
            var allGoals = 0;

            // Process team data
            foreach (var teamTask in teamTasks)
            {
                var teamsResult = await teamTask;
                if (teamsResult.Success && teamsResult.Data is not null)
                {
                    foreach (var team in teamsResult.Data)
                    {
                        activeTeamsSet.Add((team.TeamName, team.ChampionshipName));
                    }
                }
            }

            // Process statistics data
            foreach (var statsTask in statsTasks)
            {
                var statsResult = await statsTask;
                if (statsResult.Success && statsResult.Data is not null)
                {
                    allGames += statsResult.Data.Count;
                    allGoals += statsResult.Data.Sum(s => s.Goals);
                }
            }

            _activeTeams = activeTeamsSet.Count;
            _activeTeamsList = activeTeamsSet.OrderBy(t => t.TeamName).ThenBy(t => t.ChampionshipName).ToList();
            _totalGames = allGames;
            _totalGoals = allGoals;

            // Retrieve recent activities and top performers
            var recentActivityResult = await recentActivityTask;
            if (recentActivityResult.Success && recentActivityResult.Data is not null)
            {
                _recentActivities = recentActivityResult.Data;
            }

            var topPerformersResult = await topPerformersTask;
            if (topPerformersResult.Success && topPerformersResult.Data is not null)
            {
                _topPerformers = topPerformersResult.Data;
            }
        }
        catch (Exception)
        {
            // Don't expose technical details in error messages
            _errorMessage = "Unable to load dashboard data. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Color GetRankColor(int rank)
    {
        return rank switch
        {
            1 => Color.Warning,
            2 => Color.Default,
            3 => Color.Tertiary,
            _ => Color.Default
        };
    }
}